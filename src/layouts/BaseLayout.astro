---
interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/png" href="/favicon.png" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="HowToWriteYourMemoirs.com" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <style>
      :root {
        --navy: #102f5c;
        --navy-dark: #0a2344;
        --gold: #b8872d;
        --gold-dark: #91691f;
        --text: #243247;
        --muted: #657386;
        --background: #fffefc;
        --surface: #f7f4ee;
        --border: #e4ded3;
        --white: #ffffff;
      }

      * {
        box-sizing: border-box;
      }

      html {
        background: var(--background);
      }

      body {
        max-width: 1120px;
        margin: 0 auto;
        padding: 0 2rem 3rem;
        background: var(--background);
        color: var(--text);
        font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
          sans-serif;
        font-size: 18px;
        line-height: 1.75;
      }

      main {
        max-width: 820px;
        margin: 0 auto;
      }

      nav {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 2rem;
        margin-bottom: 4rem;
        padding: 1.35rem 0 1.25rem;
        border-bottom: 1px solid var(--border);
      }

      .site-logo {
        display: flex;
        align-items: center;
        flex-shrink: 0;
        text-decoration: none;
      }

      .site-logo img {
        display: block;
        width: auto;
        height: 74px;
        max-width: 430px;
      }

      .nav-links {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 1.5rem;
        flex-wrap: wrap;
      }

      .nav-links a {
        color: var(--navy);
        font-size: 0.95rem;
        font-weight: 700;
        text-decoration: none;
      }

      .nav-links a:hover {
        color: var(--gold-dark);
      }

      a {
        color: var(--navy);
        text-decoration-thickness: 1px;
        text-underline-offset: 0.18em;
      }

      a:hover {
        color: var(--gold-dark);
      }

      h1,
      h2,
      h3 {
        color: var(--navy);
        font-family: Georgia, "Times New Roman", serif;
        line-height: 1.2;
      }

      h1 {
        margin: 0 0 1.5rem;
        font-size: clamp(2.4rem, 6vw, 3.5rem);
        letter-spacing: -0.025em;
      }

      h2 {
        margin: 3.25rem 0 1rem;
        font-size: clamp(1.8rem, 4vw, 2.25rem);
      }

      h3 {
        margin: 2.4rem 0 0.8rem;
        font-size: 1.45rem;
      }

      p {
        margin: 0 0 1.35rem;
      }

      ul,
      ol {
        margin: 0 0 1.6rem;
        padding-left: 1.5rem;
      }

      li {
        margin-bottom: 0.55rem;
      }

      blockquote {
        margin: 2rem 0;
        padding: 1rem 1.5rem;
        border-left: 4px solid var(--gold);
        background: var(--surface);
        color: var(--navy-dark);
        font-family: Georgia, "Times New Roman", serif;
        font-size: 1.12rem;
      }

      article {
        margin-bottom: 4rem;
      }

      img {
        max-width: 100%;
        height: auto;
      }

      table {
        width: 100%;
        margin: 2rem 0;
        border-collapse: collapse;
        font-size: 0.96rem;
      }

      th,
      td {
        padding: 0.85rem 1rem;
        border: 1px solid var(--border);
        text-align: left;
        vertical-align: top;
      }

      th {
        background: var(--surface);
        color: var(--navy);
      }

      .button,
      .buy-button {
        display: inline-block;
        padding: 0.85rem 1.25rem;
        border: 1px solid var(--navy);
        border-radius: 6px;
        background: var(--navy);
        color: var(--white);
        font-weight: 700;
        line-height: 1.2;
        text-decoration: none;
      }

      .button:hover,
      .buy-button:hover {
        border-color: var(--navy-dark);
        background: var(--navy-dark);
        color: var(--white);
      }

      .button-secondary {
        background: transparent;
        color: var(--navy);
      }

      .button-secondary:hover {
        background: var(--surface);
        color: var(--navy-dark);
      }

      .card-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1.25rem;
        margin: 2rem 0 3rem;
      }

      .card {
        display: flex;
        flex-direction: column;
        padding: 1.5rem;
        border: 1px solid var(--border);
        border-radius: 12px;
        background: var(--surface);
      }

      .card::before {
        width: 48px;
        height: 3px;
        margin-bottom: 1rem;
        background: var(--gold);
        content: "";
      }

      .card h2,
      .card h3 {
        margin-top: 0;
      }

      .card p:last-child {
        margin-top: auto;
        margin-bottom: 0;
      }

      footer {
        max-width: 820px;
        margin: 5rem auto 0;
        padding-top: 2rem;
        border-top: 1px solid var(--border);
        color: var(--muted);
        font-size: 0.9rem;
        text-align: center;
      }

      footer p {
        margin-bottom: 0.9rem;
      }

      footer a {
        color: var(--navy);
        font-weight: 600;
        text-decoration: none;
      }

      footer a:hover {
        color: var(--gold-dark);
      }

      @media (max-width: 860px) {
        body {
          padding-right: 1.5rem;
          padding-left: 1.5rem;
        }

        nav {
          align-items: flex-start;
          flex-direction: column;
          gap: 1rem;
        }

        .site-logo img {
          width: 100%;
          height: auto;
          max-width: 400px;
        }

        .nav-links {
          justify-content: flex-start;
        }

        .card-grid {
          grid-template-columns: 1fr;
        }
      }

      @media (max-width: 520px) {
        body {
          padding-right: 1.1rem;
          padding-left: 1.1rem;
          font-size: 17px;
        }

        nav {
          margin-bottom: 2.75rem;
          padding-top: 1rem;
        }

        .site-logo img {
          max-width: 300px;
        }

        .nav-links {
          gap: 0.85rem 1.1rem;
        }

        h1 {
          font-size: 2.35rem;
        }

        h2 {
          font-size: 1.8rem;
        }

        th,
        td {
          padding: 0.7rem;
        }
      }
    </style>
  </head>

  <body>
    <nav aria-label="Main navigation">
      <a class="site-logo" href="/">
        <img
          src="/logo.svg"
          alt="HowToWriteYourMemoirs.com"
          width="1200"
          height="240"
        />
      </a>

      <div class="nav-links">
        <a href="/articles/">Articles</a>
        <a href="/about/">About</a>
        <a href="/contact/">Contact</a>
        <a href="/book/">Get the Book</a>
      </div>
    </nav>

    <main>
      <slot />
    </main>

    <footer>
      <p>© 2026 HowToWriteYourMemoirs.com</p>

      <p>
        <a href="/">Home</a> ·
        <a href="/articles/">Articles</a> ·
        <a href="/about/">About</a> ·
        <a href="/contact/">Contact</a> ·
        <a href="/privacy/">Privacy</a> ·
        <a href="/cookies/">Cookies</a> ·
        <a href="/terms/">Terms</a> ·
        <a href="/disclaimer/">Disclaimer</a> ·
        <a href="/book/">Get the Book</a>
      </p>
    </footer>
  </body>
</html>
