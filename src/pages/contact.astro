---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Contact";
const description =
  "Contact HowToWriteYourMemoirs.com with questions, suggestions, or feedback.";
---

<BaseLayout title={title} description={description}>
  <article>
    <p><a href="/">← Back to home</a></p>

    <h1>Contact</h1>

    <p>
      We'd love to hear from you.
    </p>

    <p>
      Whether you have a question about memoir writing, want to report an error,
      suggest a new topic, or share feedback, your message is welcome.
    </p>

    <h2>Email</h2>

    <p>
      <a href="mailto:kari@lionrep.com">
        kari@lionrep.com
      </a>
    </p>

    <h2>What You Can Contact Us About</h2>

    <ul>
      <li>Questions about memoir writing</li>
      <li>Suggestions for new articles</li>
      <li>Corrections or factual errors</li>
      <li>Book-related questions</li>
      <li>Partnership opportunities</li>
    </ul>

    <p>
      We read every message and will respond whenever possible.
    </p>
  </article>
</BaseLayout>
