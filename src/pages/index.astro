---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "How to Write Your Memoirs";
const description =
  "Learn practical techniques for planning, writing, editing, and publishing your personal memoirs.";
---

<BaseLayout title={title} description={description}>
  <h1>How to Write Your Memoirs</h1>

  <p>
    Learn practical techniques for turning personal experiences into engaging memoirs that readers will enjoy.
  </p>

  <p>
    Whether you are just beginning or already drafting your book, this website provides step-by-step guidance for choosing your story, organizing your memories, writing confidently, revising your manuscript, and exploring publishing options.
  </p>

  <h2>Getting Started</h2>

  <ol>
    <li>
      <a href="/how-to-write-a-memoir/">
        A Beginner's Guide to Writing a Memoir
      </a>
    </li>

    <li>
      <a href="/how-to-find-your-memoir-story/">
        Choosing the Best Story for Your Memoir
      </a>
    </li>
  </ol>
</BaseLayout>
