---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "How to Write Your Memoir";
const description =
  "Practical guidance for turning your life experiences into a compelling memoir.";
---

<BaseLayout title={title} description={description}>
  <h1>How to Write Your Memoir</h1>

  <p>
    Practical guidance for turning your life experiences into a compelling memoir.
  </p>

  <p>
    This website helps aspiring memoir writers choose their story, plan their book,
    write a first draft, edit their manuscript, and understand their publishing options.
  </p>

  <h2>Start Here</h2>

  <ol>
    <li>
      <a href="/how-to-write-a-memoir/">
        How to Write a Memoir: A Complete Beginner's Guide
      </a>
    </li>

    <li>
      <a href="/how-to-find-your-memoir-story/">
        How to Find the Right Story for Your Memoir
      </a>
    </li>
  </ol>
</BaseLayout>
